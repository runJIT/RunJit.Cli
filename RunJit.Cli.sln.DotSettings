	<s:String x:Key="/Default/PatternsAndTemplates/StructuralSearch/Pattern/=50342533E590EA46B599945696443542/ReplacePattern/@EntryValue">public $type$ $Property$&#xD;
{&#xD;
    get&#xD;
    {&#xD;
        return $mProperty$;&#xD;
    }&#xD;
&#xD;
    set&#xD;
    {&#xD;
        if ($mProperty$.NotEqualsTo($value$))&#xD;
        {&#xD;
            $mProperty$ = $value$;&#xD;
            RaisePropertyChanged(nameof($Property$));&#xD;
        }&#xD;
    }&#xD;
}</s:String>
	<s:String x:Key="/Default/PatternsAndTemplates/StructuralSearch/Pattern/=50342533E590EA46B599945696443542/SearchPattern/@EntryValue">public $type$ $Property$&#xD;
{&#xD;
    get&#xD;
    {&#xD;
        return $mProperty$;&#xD;
    }&#xD;
&#xD;
    set&#xD;
    {&#xD;
        if ($mProperty$ != $value$)&#xD;
        {&#xD;
            $mProperty$ = $value$;&#xD;
            RaisePropertyChanged(() =&gt; $Property$);&#xD;
        }&#xD;
    }&#xD;
}</s:String>
